  "ce_weight": 1.0,
  "brier_weight": 0.25,
  "log_every": 5,
  "save_every": 100,
  "gradient_checkpointing": true,
  "trust_remote_code": true,
  "lora": {
    "enabled": true,
    "rank": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "in_proj_qkvz",
      "in_proj_ba",
      "out_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  }
