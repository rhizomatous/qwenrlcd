{
  "model_id": "Qwen/Qwen3.5-2B-Base",
  "train_file": "data/smoke_train.jsonl",
  "validation_file": "data/smoke_validation.jsonl",
  "output_dir": "outputs/qwen3.5-2b-decision-smoke",
  "seed": 17,
  "max_length": 2048,
  "max_choices": 255,
  "shuffle_options": true,
  "epochs": 1,
  "micro_batch_size": 8,
