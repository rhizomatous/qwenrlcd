{
  "model_id": "Qwen/Qwen3-1.7B-Base",
  "dataset_path": "../qwenrlcd-data",
  "dataset_config": "core",
  "validation_reference_bundle_limit": 500,
  "output_dir": "outputs/qwen3-1.7b-core-option-full-v0",
  "seed": 17,
  "max_length": 4096,
  "max_questions": 32,
  "max_choices": 255,
  "require_no_state_truncation": true,
  "permute_training": true,
  "epochs": 1,
  "micro_batch_size": 2,
  "gradient_accumulation_steps": 4,
  "learning_rate": 0.0002,
  "head_learning_rate": 0.001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "max_grad_norm": 1.0,
  "ce_weight": 1.0,
  "brier_weight": 0.25,
  "ordinal_rps_weight": 0.0,
  "log_every": 50,
  "save_every": 5000,
  "keep_last_checkpoints": 1,
  "gradient_checkpointing": true,
  "trust_remote_code": true,
  "attn_implementation": "eager",
  "lora": {
    "enabled": true,
    "rank": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  }
}
